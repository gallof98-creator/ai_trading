# Copy to .env and fill in. NEVER commit .env.
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                   -> QAT_JWT_SECRET, POSTGRES_PASSWORD
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     -> QAT_CREDENTIAL_KEY

POSTGRES_PASSWORD=
QAT_ENVIRONMENT=production
QAT_JWT_SECRET=
QAT_CREDENTIAL_KEY=
QAT_CORS_ORIGINS=["http://localhost:3000"]
QAT_COOKIE_SECURE=false          # true when served over HTTPS

# First-run admin (used only while no user exists; remove afterwards). Password >= 12 chars.
QAT_ADMIN_EMAIL=
QAT_ADMIN_PASSWORD=

# --- Market data (optional) ---------------------------------------------------
# Public crypto data from a CCXT exchange (no API key, can never place orders), polled every N seconds.
# QAT_MARKET_DATA_EXCHANGE=binance
# QAT_FEED_INTERVAL_SECONDS=30
# Valuation assumption: currencies treated as 1:1 with another one. Remove an entry to require real rates.
# QAT_FX_PEGS={"USDT":"USD","USDC":"USD"}
# QAT_FX_MAX_AGE_DAYS=5

# Stock prices from EODHD (official API, your own key). Can also be entered in the dashboard, stored encrypted.
# QAT_EODHD_API_KEY=

# --- Notifications (optional) -------------------------------------------------
# QAT_SMTP_HOST=
# QAT_SMTP_PORT=587
# QAT_SMTP_USER=
# QAT_SMTP_PASSWORD=
# QAT_NOTIFY_EMAIL_TO=
# QAT_TELEGRAM_BOT_TOKEN=
# QAT_TELEGRAM_CHAT_ID=

# --- Live trading --------------------------------------------------------------
# Live trading stays OFF. Do not set these in a paper deployment.
# QAT_LIVE_TRADING_ENABLED=false
# QAT_LIVE_TRADING_CONFIRMATION=
# Read docs/legal-and-compliance.md before even considering these two settings.
